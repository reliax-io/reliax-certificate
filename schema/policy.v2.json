{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliax.io/schema/policy.v2.json",
  "title": "Reliax policy version",
  "description": "What the deployer decides, kept as a signed version. Thresholds are in the deployer's units. A change is a new version, approved by the policy owner.",
  "type": "object",
  "required": ["name", "version", "alpha", "calibration_set", "segments"],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["observe", "gate"] },
    "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "one minus the coverage target" },
    "credibility_floor": { "type": "number", "default": 0.01 },
    "credibility_extreme": { "type": "number", "default": 0.001 },
    "invalid_action": { "type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK"], "default": "BLOCK" },
    "ood_action": { "type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK"], "default": "REVIEW" },
    "ood_extreme_action": { "type": "string", "enum": ["ALLOW", "REVIEW", "BLOCK"], "default": "BLOCK" },
    "watch_action": { "type": "string", "enum": ["REVIEW", "INFO"], "default": "INFO" },
    "alarm_policy": { "type": "string", "enum": ["suspend", "weighted_stopgap"], "description": "what happens to the guarantee on ALARM before outcomes land" },
    "bracket_on": { "type": "boolean", "default": true },
    "pd_upper_allow_max": { "type": ["number", "null"] },
    "approve_label": { "type": ["integer", "null"], "default": 0 },
    "calibration_set": {
      "type": "object", "required": ["name", "n", "frozen", "sha256"],
      "properties": { "name": { "type": "string" }, "n": { "type": "integer" }, "frozen": { "type": "string" }, "sha256": { "type": "string" }, "max_age_days": { "type": "integer" } }
    },
    "segments": {
      "type": "array", "description": "business segments used at inference, never protected attributes",
      "items": { "type": "object", "required": ["name", "definition_hash"], "properties": { "name": { "type": "string" }, "definition_hash": { "type": "string" }, "definition": { "type": "string" } } }
    },
    "cell_rules": { "type": "array", "items": { "type": "object" }, "description": "slow-loop rules that put a cell on REVIEW; an open decision on where they sit in the fast loop" },
    "schema_rules": { "type": "array", "items": { "type": "object" }, "description": "the deployer's own input-schema rules, run before rule 1" },
    "surrogate": { "type": ["object", "null"], "properties": { "artifact_hash": { "type": "string" } } },
    "privacy_budget": { "type": ["object", "null"], "properties": { "epsilon": { "type": "number" }, "mechanism": { "type": "string" } } },
    "capacity": { "type": "object", "description": "review-queue capacity per route; overflow is never silently allowed" }
  }
}
